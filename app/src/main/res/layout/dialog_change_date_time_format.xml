<?xml version="1.0" encoding="utf-8"?>
<org.fossify.gallery.helpers.ClassicDialogScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/change_date_time_dialog_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/change_date_time_dialog_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingTop="@dimen/classic_dialog_content_padding"
        android:paddingRight="0dp">

        <TextView android:id="@+id/change_date_time_dialog_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/classic_date_display_title" android:textSize="20sp"
            android:fontFamily="sans-serif-medium" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="8dp" android:paddingBottom="16dp" />
        <RadioGroup
            android:id="@+id/change_date_time_dialog_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp">

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                android:textAllCaps="false"
                tools:text="dd.MM.yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                android:textAllCaps="false"
                tools:text="dd/MM/yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_three"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                android:textAllCaps="false"
                tools:text="MM/dd/yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_eight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                tools:text="dd-MM-yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_seven"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                tools:text="MM-dd-yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_four"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                android:textAllCaps="false"
                tools:text="yyyy-MM-dd" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_five"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                tools:text="d MMMM yyyy" />

            <org.fossify.commons.views.MyCompatRadioButton
                android:id="@+id/change_date_time_dialog_radio_six"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="@dimen/normal_margin"
                android:paddingBottom="@dimen/normal_margin"
                tools:text="MMMM d yyyy" />

        </RadioGroup>

        <TextView
            android:id="@+id/change_date_time_dialog_time_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/classic_time_format_section"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <org.fossify.gallery.views.ClassicCheckboxRow
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground" >
            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp"
                android:textSize="16sp" android:text="@string/use_24_hour_time_format" />
            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/change_date_time_dialog_24_hour" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" />
        </org.fossify.gallery.views.ClassicCheckboxRow>

    </LinearLayout>
</org.fossify.gallery.helpers.ClassicDialogScrollView>
