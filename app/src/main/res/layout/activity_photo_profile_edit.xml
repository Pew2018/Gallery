<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/photo_profile_edit_appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/photo_profile_edit_toolbar"
            android:layout_width="match_parent" android:layout_height="56dp"
            app:title="@string/photo_profiles_edit" />
    </org.fossify.commons.views.MyAppBarLayout>
    <ScrollView android:id="@+id/photo_profile_edit_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false"
        android:paddingBottom="16dp" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
            <TextView android:id="@+id/photo_profile_edit_name_label"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
                android:text="@string/photo_profiles_name"
                android:fontFamily="sans-serif-medium" android:textSize="12sp" />
            <EditText android:id="@+id/photo_profile_edit_name"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:singleLine="true"
                android:textSize="16sp" android:hint="@string/photo_profiles_name"
                android:inputType="textCapSentences" />
            <LinearLayout android:id="@+id/photo_profile_edit_sources"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
            <TextView android:id="@+id/photo_profile_edit_add_source"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true" android:focusable="true"
                android:text="@string/photo_profiles_add_source" android:fontFamily="sans-serif-medium"
                android:textSize="14sp" />
            <TextView android:id="@+id/photo_profile_edit_error"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="12dp"
                android:visibility="gone" android:text="@string/photo_profiles_source_required"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
