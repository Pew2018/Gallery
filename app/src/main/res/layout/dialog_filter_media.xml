<?xml version="1.0" encoding="utf-8"?>
<org.fossify.gallery.helpers.ClassicDialogScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/filter_media_dialog_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/classic_dialog_content_padding"
        android:paddingTop="@dimen/medium_margin"
        android:paddingEnd="@dimen/classic_dialog_content_padding">

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_images"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/images" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_videos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/videos" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_gifs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/gifs" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_raws"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/raw_images" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_svgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/svgs" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

        <org.fossify.gallery.views.ClassicDialogCheckboxRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.gallery.views.ClassicDialogCheckbox
                android:id="@+id/filter_media_portraits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/portraits" />
        </org.fossify.gallery.views.ClassicDialogCheckboxRow>

    </LinearLayout>
</org.fossify.gallery.helpers.ClassicDialogScrollView>
