<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/photo_profile_manage_appbar"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/photo_profile_manage_toolbar"
            android:layout_width="match_parent" android:layout_height="56dp"
            app:title="@string/photo_profiles_manage"
            app:titleTextAppearance="@style/OxygenClassicToolbarTitle" />
    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/photo_profile_manage_content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/photo_profile_manage_create"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:clickable="true" android:focusable="true">
            <ImageView android:id="@+id/photo_profile_manage_create_icon"
                android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_plus_vector" android:contentDescription="@null" />
            <TextView android:id="@+id/photo_profile_manage_create_label"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:gravity="center_vertical" android:paddingStart="16dp"
                android:text="@string/photo_profiles_create" android:textSize="16sp" />
        </LinearLayout>
        <View android:id="@+id/photo_profile_manage_create_divider"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
            android:background="@color/oxygen_classic_divider" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photo_profile_manage_list"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:clipToPadding="false" android:scrollbars="none" />

            <LinearLayout android:id="@+id/photo_profile_manage_empty"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:visibility="gone">
                <TextView android:id="@+id/photo_profile_manage_empty_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:text="@string/photo_profiles_manage_empty_title"
                    android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/photo_profile_manage_empty_description"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center"
                    android:text="@string/photo_profiles_manage_empty_description" android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
