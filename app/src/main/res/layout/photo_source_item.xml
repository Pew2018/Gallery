<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" android:orientation="vertical"
    android:focusable="true" android:clickable="true">
    <FrameLayout android:layout_width="match_parent" android:layout_height="96dp"
        android:clipChildren="true">
        <org.fossify.commons.views.MySquareImageView android:id="@+id/source_thumbnail"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_gravity="center" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/source_lock" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="center"
            android:src="@drawable/ic_lock_vector" android:importantForAccessibility="no"
            android:visibility="gone" />
        <CheckBox android:id="@+id/source_check" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="top|end"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:minWidth="0dp" android:minHeight="0dp" />
        <ImageButton android:id="@+id/source_browse" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="bottom|end"
            android:padding="12dp" android:src="@drawable/photo_source_browse"
            android:contentDescription="@string/photo_source_browse" />
    </FrameLayout>
    <TextView android:id="@+id/source_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="40dp"
        android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
        android:maxLines="2" android:ellipsize="end" android:textSize="14sp" />
    <TextView android:id="@+id/source_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="20dp"
        android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingBottom="4dp"
        android:maxLines="1" android:ellipsize="end" android:textSize="12sp" />
</LinearLayout>
