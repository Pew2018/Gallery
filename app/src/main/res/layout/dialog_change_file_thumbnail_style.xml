<?xml version="1.0" encoding="utf-8"?>
<org.fossify.gallery.helpers.ClassicDialogScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/dialog_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/dialog_file_style_spacing_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:paddingStart="24dp"
            android:paddingTop="0dp"
            android:paddingEnd="24dp"
            android:paddingBottom="0dp"
            android:minHeight="56dp">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dialog_file_style_spacing_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_toStartOf="@+id/dialog_file_style_spacing"
                android:paddingTop="8dp" android:paddingBottom="8dp"
                android:textSize="16sp"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/medium_margin"
                android:text="@string/thumbnail_spacing" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dialog_file_style_spacing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="0dp"
                android:background="@null"
                android:clickable="false"
                tools:text="1x" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/dialog_file_style_spacing_slider"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_below="@id/dialog_file_style_spacing_label"
                android:contentDescription="@string/thumbnail_spacing" />
        </RelativeLayout>

        <org.fossify.gallery.views.ClassicCheckboxRow
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground" android:id="@+id/dialog_file_style_rounded_corners_holder">
            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp"
                android:textSize="16sp" android:text="@string/rounded_corners" />
            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/dialog_file_style_rounded_corners" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:buttonTint="?attr/colorControlActivated" />
        </org.fossify.gallery.views.ClassicCheckboxRow>

        <org.fossify.gallery.views.ClassicCheckboxRow
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground" android:id="@+id/dialog_file_style_show_thumbnail_video_duration_holder">
            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp"
                android:textSize="16sp" android:text="@string/show_thumbnail_video_duration" />
            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/dialog_file_style_show_thumbnail_video_duration" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:buttonTint="?attr/colorControlActivated" />
        </org.fossify.gallery.views.ClassicCheckboxRow>

        <org.fossify.gallery.views.ClassicCheckboxRow
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground" android:id="@+id/dialog_file_style_show_thumbnail_file_types_holder">
            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp"
                android:textSize="16sp" android:text="@string/show_image_file_types" />
            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/dialog_file_style_show_thumbnail_file_types" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:buttonTint="?attr/colorControlActivated" />
        </org.fossify.gallery.views.ClassicCheckboxRow>

        <org.fossify.gallery.views.ClassicCheckboxRow
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground" android:id="@+id/dialog_file_style_mark_favorite_items_holder">
            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingTop="8dp" android:paddingBottom="8dp" android:paddingEnd="12dp"
                android:textSize="16sp" android:text="@string/mark_favorite_items" />
            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/dialog_file_style_mark_favorite_items" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="12dp" android:buttonTint="?attr/colorControlActivated" />
        </org.fossify.gallery.views.ClassicCheckboxRow>
    </LinearLayout>
</org.fossify.gallery.helpers.ClassicDialogScrollView>
