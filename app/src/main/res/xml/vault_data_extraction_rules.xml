<?xml version="1.0" encoding="utf-8"?>
<!-- Never transfer the private vault or its wrapped key metadata.
     App-wide backup is disabled in the manifest as the safer default. -->
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="private_vault_v1/" />
        <exclude domain="sharedpref" path="encrypted_vault_v1.xml" />
        <exclude domain="cache" path="vault_previews/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="private_vault_v1/" />
        <exclude domain="sharedpref" path="encrypted_vault_v1.xml" />
        <exclude domain="cache" path="vault_previews/" />
    </device-transfer>
</data-extraction-rules>
