<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OxygenOS 4.5.15 screenshot-derived visual baselines; user-selected
         Fossify colors still control interactive tints and dark themes. -->
    <color name="oxygen_classic_toolbar">#212121</color>
    <color name="oxygen_classic_statusbar">#1E1E1E</color>
    <color name="oxygen_classic_page">#FAFAFA</color>
    <color name="oxygen_classic_surface">#FFFFFF</color>
    <color name="oxygen_classic_accent">#2196F3</color>
    <color name="oxygen_classic_file_manager_blue">#0071CD</color>
    <color name="oxygen_classic_divider">#E6E6E6</color>

    <dimen name="oxygen_classic_toolbar_height">56dp</dimen>
    <dimen name="oxygen_classic_horizontal_margin">16dp</dimen>
    <dimen name="oxygen_classic_single_row">56dp</dimen>
    <dimen name="oxygen_classic_details_row">72dp</dimen>
    <dimen name="oxygen_classic_switch_width">42dp</dimen>
    <dimen name="oxygen_classic_switch_thumb_size">24dp</dimen>

    <style name="OxygenClassicSettingsSection" parent="SettingsSectionLabelStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="OxygenClassicSettingsSwitchRow" parent="SettingsHolderSwitchStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_single_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsSingleRow" parent="SettingsHolderTextViewOneLinerStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_single_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsDetailsRow" parent="SettingsHolderTextViewStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_details_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsSecondaryText" parent="SettingsTextValueStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.54</item>
    </style>

    <!-- Theme is applied after Commons has selected the saved dark/light palette.
         It overrides Material3 decoration without replacing Commons' parent Theme. -->
    <color name="oxygen_classic_on_light">#212121</color>
    <color name="oxygen_classic_on_dark">#FAFAFA</color>
    <color name="oxygen_classic_dialog_dark">#303030</color>

    <style name="OxygenClassicActivityOverlay" />
    <style name="OxygenClassicActivityOverlay.Light">
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_light</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Light</item>
        <item name="actionBarPopupTheme">@style/OxygenClassicPopupTheme.Light</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
        <item name="radioButtonStyle">@style/OxygenClassicRadio</item>
        <item name="android:checkboxStyle">@style/OxygenClassicCheckbox</item>
        <item name="materialAlertDialogTheme">@style/OxygenClassicMaterialDialog.Light</item>
        <item name="alertDialogTheme">@style/OxygenClassicAlertDialog.Light</item>
        <item name="android:alertDialogTheme">@style/OxygenClassicAlertDialog.Light</item>
    </style>
    <style name="OxygenClassicActivityOverlay.Dark">
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_dark</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Dark</item>
        <item name="actionBarPopupTheme">@style/OxygenClassicPopupTheme.Dark</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
        <item name="radioButtonStyle">@style/OxygenClassicRadio</item>
        <item name="android:checkboxStyle">@style/OxygenClassicCheckbox</item>
        <item name="materialAlertDialogTheme">@style/OxygenClassicMaterialDialog.Dark</item>
        <item name="alertDialogTheme">@style/OxygenClassicAlertDialog.Dark</item>
        <item name="android:alertDialogTheme">@style/OxygenClassicAlertDialog.Dark</item>
    </style>
    <!-- 2017 check/radio controls; do not inherit the M3 control geometry. -->
    <style name="OxygenClassicRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="OxygenClassicCheckbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="OxygenClassicDialogShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">3dp</item>
    </style>
    <style name="OxygenClassicMaterialDialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_light</item>
        <item name="shapeAppearance">@style/OxygenClassicDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/OxygenClassicDialogTitle.Light</item>
    </style>
    <style name="OxygenClassicMaterialDialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_dark</item>
        <item name="shapeAppearance">@style/OxygenClassicDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/OxygenClassicDialogTitle.Dark</item>
    </style>
    <style name="OxygenClassicDialogTitle.Light" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/oxygen_classic_on_light</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OxygenClassicDialogTitle.Dark" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/oxygen_classic_on_dark</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OxygenClassicAlertDialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_light</item>
        <item name="android:textColorHint">#757575</item>
        <item name="android:windowBackground">@drawable/oxygen_classic_popup_light</item>
    </style>
    <style name="OxygenClassicAlertDialog.Dark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_dark</item>
        <item name="android:textColorHint">#BDBDBD</item>
        <item name="android:windowBackground">@drawable/oxygen_classic_popup_dark</item>
    </style>
    <style name="OxygenClassicOverflow.Light" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/oxygen_classic_popup_light</item>
    </style>
    <style name="OxygenClassicOverflow.Dark" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/oxygen_classic_popup_dark</item>
    </style>

    <!-- Keep menus on a neutral surface, never the user's accent color. -->
    <style name="OxygenClassicPopupTheme.Light" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_light</item>
        <item name="android:textColorSecondary">@color/oxygen_classic_on_light</item>
        <item name="android:textColor">@color/oxygen_classic_on_light</item>
        <item name="colorControlNormal">@color/oxygen_classic_on_light</item>
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_light</item>
        <item name="textAppearanceLargePopupMenu">@style/OxygenClassicPopupText.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/OxygenClassicPopupText.Light</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
        <item name="android:popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
    </style>
    <style name="OxygenClassicPopupTheme.Dark" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_dark</item>
        <item name="android:textColorSecondary">@color/oxygen_classic_on_dark</item>
        <item name="android:textColor">@color/oxygen_classic_on_dark</item>
        <item name="colorControlNormal">@color/oxygen_classic_on_dark</item>
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_dark</item>
        <item name="textAppearanceLargePopupMenu">@style/OxygenClassicPopupText.Dark</item>
        <item name="textAppearanceSmallPopupMenu">@style/OxygenClassicPopupText.Dark</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
        <item name="android:popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
    </style>
    <style name="OxygenClassicPopupMenu.Light" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/oxygen_classic_popup_light</item>
    </style>
    <style name="OxygenClassicPopupMenu.Dark" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/oxygen_classic_popup_dark</item>
    </style>

    <style name="OxygenClassicPopupText.Light" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/oxygen_classic_on_light</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="OxygenClassicPopupText.Dark" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/oxygen_classic_on_dark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="OxygenClassicDialogButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
