<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OxygenOS 4.5.15 screenshot-derived visual baselines; user-selected
         Fossify colors still control interactive tints and dark themes. -->
    <color name="oxygen_classic_toolbar">#212121</color>
    <color name="oxygen_classic_statusbar">#1E1E1E</color>
    <color name="oxygen_classic_page">#FAFAFA</color>
    <color name="oxygen_classic_surface">#FFFFFF</color>
    <color name="oxygen_classic_accent">#2196F3</color>
    <color name="oxygen_classic_file_manager_blue">#0071CD</color>
    <color name="oxygen_classic_divider">#E6E6E6</color>

    <!-- AppCompat overflow buttons are 40dp wide; explicit menu targets are 48dp.
         Align the popup edge at the glyph center (within 4dp), as in the reference. -->
    <dimen name="oxygen_classic_overflow_horizontal_offset">-20dp</dimen>
    <!-- Reference popup panel is about 188dp wide at the source screenshot scale. -->
    <dimen name="oxygen_classic_menu_min_width">188dp</dimen>
    <dimen name="oxygen_classic_toolbar_height">56dp</dimen>
    <dimen name="oxygen_classic_horizontal_margin">16dp</dimen>
    <dimen name="oxygen_classic_single_row">56dp</dimen>
    <dimen name="oxygen_classic_details_row">72dp</dimen>
    <dimen name="oxygen_classic_switch_width">48dp</dimen>
    <dimen name="oxygen_classic_switch_thumb_size">24dp</dimen>

    <!-- Window animation values are resource tokens because Android's WindowManager loads them from XML. -->
    <integer name="oxygen_classic_dialog_enter_duration_ms">170</integer>
    <integer name="oxygen_classic_dialog_exit_duration_ms">130</integer>
    <dimen name="oxygen_classic_dialog_motion_distance">6dp</dimen>

    <!-- Activity Window motion tokens; kept in XML for WindowManager-owned transitions. -->
    <integer name="oxygen_classic_page_enter_duration_ms">170</integer>
    <integer name="oxygen_classic_page_exit_duration_ms">140</integer>
    <dimen name="oxygen_classic_page_enter_offset">14dp</dimen>
    <dimen name="oxygen_classic_page_return_offset">10dp</dimen>
    <style name="OxygenClassicPageWindow">
        <item name="android:windowEnterAnimation">@anim/oxygen_classic_page_open_enter</item>
        <item name="android:windowExitAnimation">@anim/oxygen_classic_page_open_exit</item>
    </style>

    <!-- Screenshot-fit/application tokens, not extracted OxygenOS ROM resources. -->
    <dimen name="oxygen_classic_settings_summary">13sp</dimen>
    <dimen name="oxygen_classic_settings_section">48dp</dimen>

    <style name="OxygenClassicToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="OxygenClassicSettingsSection">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:tag">classic_section</item>
        <item name="android:minHeight">@dimen/oxygen_classic_settings_section</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="OxygenClassicSettingsSwitchRow" parent="SettingsHolderSwitchStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_single_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsSingleRow" parent="SettingsHolderTextViewOneLinerStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_single_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsDetailsRow" parent="SettingsHolderTextViewStyle">
        <item name="android:minHeight">@dimen/oxygen_classic_details_row</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsSecondaryText">
        <item name="android:textSize">@dimen/oxygen_classic_settings_summary</item>
        <item name="android:alpha">1</item>
        <item name="android:tag">classic_secondary</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="OxygenClassicSettingsPrimaryText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="OxygenClassicSettingsSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:singleLine">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <!-- The settings row owns the single ripple. The Switch itself spans
             the row width so a second selectable background would duplicate it. -->
        <item name="android:background">@android:color/transparent</item>
        <item name="showText">false</item>
        <item name="switchPadding">24dp</item>
    </style>

    <!-- Theme is applied after Commons has selected the saved dark/light palette.
         It overrides Material3 decoration without replacing Commons' parent Theme. -->
    <color name="oxygen_classic_on_light">#212121</color>
    <color name="oxygen_classic_on_dark">#FAFAFA</color>
    <color name="oxygen_classic_dialog_dark">#303030</color>

    <style name="OxygenClassicActivityOverlay" />
    <style name="OxygenClassicActivityOverlay.Light">
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_light</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Light</item>
        <item name="actionBarPopupTheme">@style/OxygenClassicPopupTheme.Light</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
        <item name="radioButtonStyle">@style/OxygenClassicRadio</item>
        <item name="android:checkboxStyle">@style/OxygenClassicCheckbox</item>
        <item name="materialAlertDialogTheme">@style/OxygenClassicMaterialDialog.Light</item>
        <item name="alertDialogTheme">@style/OxygenClassicAlertDialog.Light</item>
        <item name="android:alertDialogTheme">@style/OxygenClassicAlertDialog.Light</item>
    </style>
    <style name="OxygenClassicActivityOverlay.Dark">
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_dark</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Dark</item>
        <item name="actionBarPopupTheme">@style/OxygenClassicPopupTheme.Dark</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
        <item name="radioButtonStyle">@style/OxygenClassicRadio</item>
        <item name="android:checkboxStyle">@style/OxygenClassicCheckbox</item>
        <item name="materialAlertDialogTheme">@style/OxygenClassicMaterialDialog.Dark</item>
        <item name="alertDialogTheme">@style/OxygenClassicAlertDialog.Dark</item>
        <item name="android:alertDialogTheme">@style/OxygenClassicAlertDialog.Dark</item>
    </style>
    <!-- 2017 check/radio controls; do not inherit the M3 control geometry. -->
    <style name="OxygenClassicRadio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="OxygenClassicCheckbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="OxygenClassicPopupCheckbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:background">@null</item>
        <!-- Preserve a row-sized target while drawing a compact classic square. -->
        <item name="android:button">@drawable/oxygen_classic_popup_checkbox</item>
        <item name="buttonTint">@null</item>
        <item name="android:buttonTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="OxygenClassicDialogShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="OxygenClassicMaterialDialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_light</item>
        <item name="shapeAppearance">@style/OxygenClassicDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/OxygenClassicDialogTitle.Light</item>
    </style>
    <style name="OxygenClassicMaterialDialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_on_dark</item>
        <item name="shapeAppearance">@style/OxygenClassicDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/OxygenClassicDialogTitle.Dark</item>
    </style>
    <style name="OxygenClassicDialogTitle.Light" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/oxygen_classic_on_light</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OxygenClassicDialogTitle.Dark" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/oxygen_classic_on_dark</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="OxygenClassicAlertDialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_light</item>
        <item name="android:textColorHint">#757575</item>
        <item name="android:windowBackground">@drawable/oxygen_classic_popup_light</item>
    </style>
    <style name="OxygenClassicAlertDialog.Dark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:textColorPrimary">@color/oxygen_classic_on_dark</item>
        <item name="android:textColorHint">#BDBDBD</item>
        <item name="android:windowBackground">@drawable/oxygen_classic_popup_dark</item>
    </style>
    <style name="OxygenClassicOverflow.Light" parent="OxygenClassicPopupMenu.Light">
        <!-- Keep the panel below the Toolbar action row, as in OxygenOS Classic. -->
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownHorizontalOffset">@dimen/oxygen_classic_overflow_horizontal_offset</item>
        <item name="android:dropDownVerticalOffset">12dp</item>
    </style>
    <style name="OxygenClassicOverflow.Dark" parent="OxygenClassicPopupMenu.Dark">
        <!-- Keep the panel below the Toolbar action row, as in OxygenOS Classic. -->
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownHorizontalOffset">@dimen/oxygen_classic_overflow_horizontal_offset</item>
        <item name="android:dropDownVerticalOffset">12dp</item>
    </style>

    <!-- Keep menus on a neutral surface, never the user's accent color. -->
    <style name="OxygenClassicPopupTheme.Light" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/oxygen_classic_menu_text_light</item>
        <item name="android:textColorSecondary">@color/oxygen_classic_menu_text_light</item>
        <item name="android:textColor">@color/oxygen_classic_menu_text_light</item>
        <item name="colorControlNormal">@color/oxygen_classic_menu_text_light</item>
        <item name="colorControlActivated">@color/oxygen_classic_accent</item>
        <item name="checkboxStyle">@style/OxygenClassicPopupCheckbox</item>
        <item name="android:checkboxStyle">@style/OxygenClassicPopupCheckbox</item>
        <item name="colorSurface">@color/oxygen_classic_surface</item>
        <item name="colorOnSurface">@color/oxygen_classic_menu_text_light</item>
        <item name="textAppearanceLargePopupMenu">@style/OxygenClassicPopupText.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/OxygenClassicPopupText.Light</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
        <item name="android:popupMenuStyle">@style/OxygenClassicPopupMenu.Light</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Light</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
        <item name="dropdownListPreferredItemHeight">48dp</item>
        <item name="listPreferredItemPaddingLeft">16dp</item>
        <item name="listPreferredItemPaddingRight">16dp</item>
        <item name="listMenuViewStyle">@style/OxygenClassicMenuList</item>
    </style>
    <style name="OxygenClassicPopupTheme.Dark" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:textColorPrimary">@color/oxygen_classic_menu_text_dark</item>
        <item name="android:textColorSecondary">@color/oxygen_classic_menu_text_dark</item>
        <item name="android:textColor">@color/oxygen_classic_menu_text_dark</item>
        <item name="colorControlNormal">@color/oxygen_classic_menu_text_dark</item>
        <item name="colorControlActivated">@color/oxygen_classic_accent</item>
        <item name="checkboxStyle">@style/OxygenClassicPopupCheckbox</item>
        <item name="android:checkboxStyle">@style/OxygenClassicPopupCheckbox</item>
        <item name="colorSurface">@color/oxygen_classic_dialog_dark</item>
        <item name="colorOnSurface">@color/oxygen_classic_menu_text_dark</item>
        <item name="textAppearanceLargePopupMenu">@style/OxygenClassicPopupText.Dark</item>
        <item name="textAppearanceSmallPopupMenu">@style/OxygenClassicPopupText.Dark</item>
        <item name="popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
        <item name="android:popupMenuStyle">@style/OxygenClassicPopupMenu.Dark</item>
        <item name="actionOverflowMenuStyle">@style/OxygenClassicOverflow.Dark</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
        <item name="dropdownListPreferredItemHeight">48dp</item>
        <item name="listPreferredItemPaddingLeft">16dp</item>
        <item name="listPreferredItemPaddingRight">16dp</item>
        <item name="listMenuViewStyle">@style/OxygenClassicMenuList</item>
    </style>
    <style name="OxygenClassicPopupMenu.Light" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/oxygen_classic_menu_light</item>
        <item name="android:popupElevation">8dp</item>
    </style>
    <style name="OxygenClassicPopupMenu.Dark" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/oxygen_classic_menu_dark</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="OxygenClassicPopupText.Light" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/oxygen_classic_menu_text_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="OxygenClassicPopupText.Dark" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/oxygen_classic_menu_text_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Native menu dispatch, checkbox state, submenus and window clipping stay AppCompat-owned. -->
    <style name="OxygenClassicMenuList" parent="Widget.AppCompat.ListView.Menu">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <style name="OxygenClassicDialogWindow">
        <item name="android:windowEnterAnimation">@anim/oxygen_classic_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/oxygen_classic_dialog_exit</item>
    </style>

    <style name="OxygenClassicDialogButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
