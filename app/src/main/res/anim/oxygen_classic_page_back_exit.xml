<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <!-- Post-commit motion of the closing page in the platform's custom
         cross-Activity back animation. The platform already scales and offsets
         the closing window by swipe edge; an extra alpha fade here would be a
         second exit stage and would expose the backdrop/black around the photo.
         Keep it identity so the system animation is the only visual owner. -->
    <alpha
        android:duration="@integer/oxygen_classic_page_exit_duration_ms"
        android:fromAlpha="1.0"
        android:toAlpha="1.0" />
</set>
